{
  "name": "@seal-harness/provider-pi-ai",
  "version": "0.3.1",
  "description": "Pi AI model provider plugin for Seal Harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@seal-harness/core": "workspace:^",
    "@seal-harness/kernel": "workspace:^",
    "@seal-harness/runtime-pi": "workspace:^",
    "typebox": "1.3.7"
  },
  "license": "MIT"
}
