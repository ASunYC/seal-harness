{
  "name": "@seal-harness/runtime-scripted",
  "version": "0.2.0",
  "description": "Deterministic replaceable runtime plugin for Seal Harness tests and demos",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seal-harness/core": "workspace:^",
    "@seal-harness/kernel": "workspace:^"
  },
  "devDependencies": {
    "@seal-harness/agent-core": "workspace:^",
    "@seal-harness/context-core": "workspace:^",
    "@seal-harness/host": "workspace:^",
    "@seal-harness/session-memory": "workspace:^"
  },
  "license": "MIT"
}
