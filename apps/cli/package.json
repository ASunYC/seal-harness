    "@seal-harness/feedback-tools": "workspace:^",
    "@seal-harness/host": "workspace:^",
    "@seal-harness/kernel": "workspace:^",
    "@seal-harness/jobs-local": "workspace:^",
    "@seal-harness/lsp-core": "workspace:^",
    "@seal-harness/lsp-stdio": "workspace:^",
