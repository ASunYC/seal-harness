{
  "name": "@piharness/cli",
  "version": "0.1.0",
  "description": "Headless CLI for PiHarness",
  "type": "module",
  "bin": { "piharness": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@piharness/agent-core": "workspace:^",
    "@piharness/approval-stdio": "workspace:^",
    "@piharness/context-files": "workspace:^",
    "@piharness/core": "workspace:^",
    "@piharness/credentials-env": "workspace:^",
    "@piharness/host": "workspace:^",
    "@piharness/kernel": "workspace:^",
    "@piharness/policy-basic": "workspace:^",
    "@piharness/provider-pi-ai": "workspace:^",
    "@piharness/runtime-pi": "workspace:^",
    "@piharness/session-jsonl": "workspace:^",
    "@piharness/tools-core": "workspace:^",
    "@piharness/workspace-tools": "workspace:^"
  },
  "devDependencies": {
    "@piharness/model-scripted": "workspace:^"
  },
  "license": "MIT"
}
