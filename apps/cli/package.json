{
  "name": "@seal-harness/cli",
  "version": "0.3.1",
  "description": "Headless CLI for Seal Harness",
  "type": "module",
  "bin": { "seal-harness-headless": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seal-harness/agent-core": "workspace:^",
    "@seal-harness/attachment-local": "workspace:^",
    "@seal-harness/approval-stdio": "workspace:^",
    "@seal-harness/context-core": "workspace:^",
    "@seal-harness/context-files": "workspace:^",
    "@seal-harness/compaction-window": "workspace:^",
    "@seal-harness/core": "workspace:^",
    "@seal-harness/credentials-env": "workspace:^",
    "@seal-harness/host": "workspace:^",
    "@seal-harness/kernel": "workspace:^",
    "@seal-harness/policy-basic": "workspace:^",
    "@seal-harness/provider-pi-ai": "workspace:^",
    "@seal-harness/runtime-pi": "workspace:^",
    "@seal-harness/session-jsonl": "workspace:^",
    "@seal-harness/telemetry-noop": "workspace:^",
    "@seal-harness/tools-core": "workspace:^",
    "@seal-harness/workspace-tools": "workspace:^"
  },
  "devDependencies": {
    "@seal-harness/model-scripted": "workspace:^",
    "@seal-harness/session-memory": "workspace:^"
  },
  "license": "MIT"
}
