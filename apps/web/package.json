{
  "name": "@seal-harness/web",
  "version": "0.3.4",
  "description": "Local Web UI and HTTP streaming host for Seal Harness",
  "type": "module",
  "bin": {
    "seal-harness-web": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-react-runtime.mjs && node scripts/copy-public.mjs",
    "clean": "node -e \"for(const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "smoke:official": "node scripts/smoke-official-shell.mjs",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
