{
  "name": "@seal-harness/navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seal Harness 两级桌面导航",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.7-alpha.2"
  }
}
