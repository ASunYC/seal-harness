{
  "name": "@seal-harness/office",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local Apache GenOffice core document editing",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@seal-harness/identity"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@seal-harness/identity": "0.1.0",
    "@seal-harness/local-data": "0.1.0",
    "react": "18.3.1",
    "zod": "4.4.3"
  },
  "office": {
    "storageNamespace": "seal-harness"
  }
}
